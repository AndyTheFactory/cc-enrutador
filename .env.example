# Optional explicit config path
CC_ENRUTADOR_CONFIG=config.example.yaml

# Simple-tier example endpoint.
# Replace with your self-hosted or provider-compatible URL.
SIMPLE_BASE_URL=http://127.0.0.1:8000/v1

# Optional credential referenced by config.example.yaml but never stored in YAML.
# Leave blank if your endpoint does not require authentication; doctor will report a warning.
SIMPLE_API_KEY=

# Simple-tier example model identifier.
# Replace with your self-hosted or provider-compatible model.
SIMPLE_MODEL=ollama/qwen3-coder

# Medium-tier example endpoint.
# Replace with your self-hosted or provider-compatible URL.
MEDIUM_BASE_URL=http://127.0.0.1:8000/v1

# Optional credential referenced by config.example.yaml but never stored in YAML.
# Leave blank if your endpoint does not require authentication; doctor will report a warning.
MEDIUM_API_KEY=

# Medium-tier example model identifier.
# Replace with your self-hosted or provider-compatible model.
MEDIUM_MODEL=openai/gpt-oss-120b


# Optional dedicated JEV classifier credential (OpenRouter Decisions API).
# Required when classifier.model.provider=openrouter_decisions and mode=ai/hybrid
# or classifier.jev.shadow.enabled=true. Do not put the secret into api_key_env YAML.
OPENROUTER_API_KEY=
